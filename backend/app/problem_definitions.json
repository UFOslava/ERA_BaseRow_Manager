[
  {
    "id": "prod_no_assembly",
    "name": "Production item not belonging in any assembly",
    "rule": {
      "conditions": [
        {
          "type": "AND",
          "conditions": [
            {
              "field": "is_in_assembly",
              "operator": "equals",
              "value": "false"
            },
            {
              "field": "State",
              "operator": "equals",
              "value": "Production Use"
            }
          ]
        },
        {
          "field": "Part Number",
          "operator": "contains",
          "value": "80-"
        }
      ],
      "type": "OR"
    }
  },
  {
    "id": "non_octopart_source",
    "name": "COTS with no purchase link.",
    "rule": {
      "conditions": [
        {
          "conditions": [
            {
              "field": "Sourced By",
              "operator": "equals",
              "value": "Purchased by Contractor"
            },
            {
              "field": "Sourced By",
              "operator": "equals",
              "value": "Purchased by ERA"
            }
          ],
          "type": "OR"
        },
        {
          "field": "Source URL",
          "operator": "is_empty",
          "value": ""
        }
      ],
      "type": "AND"
    }
  }
]