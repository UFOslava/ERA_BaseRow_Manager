[
  {
    "id": "prod_no_assembly",
    "name": "Production item not belonging in any assembly",
    "rule": {
      "conditions": [
        {
          "field": "State",
          "operator": "equals",
          "value": "Production Use"
        },
        {
          "field": "is_in_assembly",
          "operator": "equals",
          "value": "false"
        }
      ],
      "type": "AND"
    }
  },
  {
    "id": "non_octopart_source",
    "name": "Source link is not an Octopart link",
    "rule": {
      "conditions": [
        {
          "field": "Source URL",
          "operator": "is_not_empty",
          "value": ""
        },
        {
          "field": "Source URL",
          "operator": "not_contains",
          "value": "octopart.com"
        }
      ],
      "type": "AND"
    }
  }
]