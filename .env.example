# ==========================================
# ERA ERP / BaseRow Manager Environment Config
# ==========================================

# Baserow API Connection Details
BASEROW_API_URL=http://localhost:7070
BASEROW_TOKEN=your-baserow-api-token-here

# Baserow Admin Credentials (optional / migration utility)
BASEROW_ADMIN_EMAIL=UFOslava@hotmail.com
BASEROW_ADMIN_PASSWORD=your-baserow-admin-password-here

# Baserow Table IDs
BASEROW_TABLE_BOM=508
BASEROW_TABLE_ASSEMBLY=701
BASEROW_TABLE_INSTRUCTIONS=5770
BASEROW_TABLE_PN_CATEGORIES=42471
BASEROW_TABLE_ITEM_STATES=48537
BASEROW_TABLE_WI_TEMPLATES=48538
BASEROW_TABLE_MANUFACTURERS=683
BASEROW_TABLE_SUPPLIERS=682
BASEROW_TABLE_CONTACTS=684

# Frontend Backend API Endpoint (used during Docker build / client requests)
VITE_API_URL=http://localhost:5000

# Backend Flask Configuration
FLASK_APP=run.py
FLASK_ENV=production
DATABASE_URL=/app/data/parts.db

# Model Context Protocol (MCP) Configuration
# Set MCP_AUTH_TOKEN to a secure secret to enable Bearer/API-key/Query authentication for Gemini / AI agents.
# Leave empty to allow unauthenticated access for offline local development.
MCP_AUTH_TOKEN=your-secure-mcp-auth-token-here
MCP_PORT=8001

# OAuth & StreamableHTTP Configuration (for Gemini Spark support)
OAUTH_ISSUER_URL=http://localhost:10000
MCP_RESOURCE_URL=http://localhost:8001
OAUTH_HOST=127.0.0.1
OAUTH_PORT=10000
